# Copia este archivo como .env y CAMBIA la contraseña del administrador.
SIGA_ADMIN_USER=admin
SIGA_ADMIN_PASSWORD=CAMBIA-ESTA-CLAVE-POR-UNA-LARGA-Y-UNICA
SIGA_HOST=0.0.0.0
SIGA_PORT=8080
SIGA_TOKEN_HOURS=8

# Producción recomendada: PostgreSQL local o servidor protegido.
DATABASE_URL=postgresql+psycopg://sigacecyteo:CAMBIAR_CLAVE_DB@127.0.0.1:5432/sigacecyteo

# Solo para pruebas nuevas, crea las cuentas de demostración 2026001/2026002.
# No habilitar en producción.
SIGA_SEED_DEMO=false
